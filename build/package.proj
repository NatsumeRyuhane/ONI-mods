<Project DefaultTargets="Package" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Builds every mod in ONI-mods.sln in Release and assembles one folder per mod in build/out/.
    Each folder holds the mod DLL plus generated mod.yaml and mod_info.yaml, ready to copy into the
    game's mods folder:

        msbuild build/package.proj

    This file is not part of the solution, so the solution and Rider/Visual Studio are unaffected.
    The metadata below is the single source for the YAML files.
  -->
  <PropertyGroup>
    <RepoDir>$(MSBuildThisFileDirectory)../</RepoDir>
    <OutDir>$(MSBuildThisFileDirectory)out/</OutDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Mod>
      <Version>1.0.0</Version>
      <MinimumSupportedBuild>0</MinimumSupportedBuild>
    </Mod>
  </ItemDefinitionGroup>

  <!--
    Identity: project folder and AssemblyName.
    Folder: name of the mod folder in the game's mods directory.
    StaticId: mod.yaml staticID. Keep it stable, because mods.json keys on it.
    Version: mod_info.yaml version, 1.0.0 unless set. Bump it with each release (see Versioning in the README).
    Description: plain ASCII, without double quotes, semicolons or percent signs.
  -->
  <ItemGroup>
    <Mod Include="AbyssaliteToTungsten" Folder="AbyssaliteToTungsten" Title="Abyssalite to Tungsten" StaticId="AbyssaliteToTungsten"
         Description="Adds an Abyssalite to Tungsten recipe to the Metal Refinery and the Molecular Forge. Each takes 100 kg of Abyssalite and makes 100 kg of Tungsten. The Metal Refinery takes 40 s but needs coolant to absorb the heat. The Molecular Forge takes 80 s and needs no coolant. A Balance heat production option, on by default, triples the heat sent to the coolant." />
    <Mod Include="BatteryNoPowerLoss" Folder="BatteryNoPowerLoss" Title="Battery No Power Loss" StaticId="BatteryNoPowerLoss" Version="1.1.0"
         Description="Batteries, Jumbo Batteries, Smart Batteries and Battery Modules no longer lose stored power over time or give off heat." />
    <Mod Include="BetterEmptier" Folder="BetterEmptier" Title="Better Emptier" StaticId="BetterEmptier"
         Description="Bottle Emptiers and Gas Bottle Emptiers get a configurable storage capacity (default 200 kg) and release speed multiplier (default 1x)." />
    <Mod Include="RadiationFieldLamp" Folder="RadiationFieldLamp" Title="Radiation Field Lamp" StaticId="BetterRadiationLamp" Version="2.0.0"
         Description="Adds the Radiation Field Lamp, a new building that keeps an even field of radiation in a 4x3 area, its own cell, the cells beside it and the 3x3 area in front of it, in the direction it was placed. Each lamp has a slider for its radiation per cell, and burns Uranium Ore in proportion to it. The default and maximum radiation, the Uranium Ore per rad and the power use are configurable (defaults: 500 and 1000 rads per cell, 9.75 mg/s per rad, 10 W). The default Uranium Ore per rad matches the vanilla Radiation Lamp for the radiation it delivers. An optional setting lets built lamps be re-pointed, diagonals included, with the Radbolt Reflector direction panel." />
    <Mod Include="BuffedAETN" Folder="BuffedAETN" Title="BuffedAETN" StaticId="BuffedAETN" Version="2.0.0"
         Description="Each Anti Entropy Thermo-Nullifier (AETN) gets two sliders, cooling power and minimum operating temperature, that apply right away. Hydrogen use follows the cooling power (configurable as heat removed per gram of Hydrogen, default 8 kDTU per gram, so 10 g/s at the vanilla 80 kW) and it buffers 10 seconds of Hydrogen, like vanilla. The lowest minimum temperature rises with the cooling power (0.05 K per kW), so a strong AETN stops before it can cool anything below absolute zero. The top of the cooling slider is configurable (default 2000 kW). New AETNs start at the vanilla 80 kW and 100 K. It can no longer be flooded." />
    <Mod Include="BuffedWheezewort" Folder="BuffedWheezewort" Title="BuffedWheezewort" StaticId="BuffedWheezewort" Version="2.0.0"
         Description="Makes the Wheezewort a configurable cooler. Every option defaults to the vanilla value: gas throughput (1 kg/s planted, a quarter of that wild), how much it cools the gas (5 K), whether it may cool gas below its condensation point (off), Phosphorite use in g per cycle (4000; 0 means it needs no fertilizer), growth temperature range (213.15 to 368.15 K, dying 30 K below and 95 K above it) and radiation (480 rads)." />
    <Mod Include="CheapWiresAndPipes" Folder="CheapWiresAndPipes" Title="Cheap Wires And Pipes" StaticId="CheapWiresAndPipes" MinimumSupportedBuild="468097"
         Description="Wires, wire bridges, gas, liquid and solid conduits, radiant pipes and logic wires cost only 1 kg of construction material." />
    <Mod Include="ConservationOfMass" Folder="ConservationOfMass" Title="Conservation of Mass" StaticId="ConservationOfMass" Version="1.0.1"
         Description="Every tile that is dug out or destroyed drops all of its mass instead of half, so no mass is lost when tiles break." />
    <Mod Include="EfficientTuneUp" Folder="EfficientTuneUp" Title="Efficient Tune-Up" StaticId="EfficientTuneUp"
         Description="Engie's Tune-Up makes a generator waste less instead of making energy from nothing. A tune-up still raises the power by half for the same fuel, and the generator now gives off that much less heat: a tuned Coal Generator makes 900 W and gives off 8.7 kW instead of 9 kW. The cut is the tuned share of the power the generator actually makes, so it also works for the Steam Turbine and Tidal Turbine, split between exhaust and self heat as the building splits them, and never more than the heat itself. It shows as its own line under Heat Production. Works with every generator that takes a tune-up, modded ones included." />
    <Mod Include="ElectrolyzerNoOverPressure" Folder="ElectrolyzerNoOverPressure" Title="Electrolyzer No Overpressure" StaticId="ElectrolyzerNoOverpressure" Version="1.0.1"
         Description="Electrolyzers never stop because of overpressure." />
    <Mod Include="FastTempShiftPlateBuild" Folder="FastTempShiftPlateBuild" Title="Fast Temp Shift Plate Build" StaticId="FastTempShiftPlateBuild" Version="1.0.1"
         Description="Temperature Shift Plates build in 6 seconds, deconstruct in 3 seconds, and use 500 kg of material." />
    <Mod Include="FoodGenerator" Folder="FoodGenerator" Title="Food Generator" StaticId="FoodGenerator"
         Description="Adds the Food Generator, a generator with the Coal Generator art, size, power and heat that burns food to order. Each food is a recipe in the usual fabricator queue, and one order burns exactly one unit of it. Calories become energy at 4184 J per kcal, which pays for both the power (default 600 W) and the heat the generator gives off (default 8 kW exhaust and 1 kW self heat, like the Coal Generator), so it burns about 1377 kcal a cycle and a unit of Mush Bar lasts about 349 s. A tune-up raises the power by half and the food pays for it, unless the Efficient Tune-Up mod is installed, which takes the extra power out of the heat instead. It gives off Carbon Dioxide and Steam worked out from what each food is made of, its share of carbohydrate, protein and fat read from its description, plus its moisture. Like the Coal Generator, it has a fuel request threshold: no food is fetched while every connected battery is at or above it. It sits next to the Coal Generator in the Power menu and is unlocked by the same research, Combustion." />
    <Mod Include="HeatReducer" Folder="HeatReducer" Title="Heat Reducer" StaticId="HeatReducer" Version="1.2.0"
         Description="Caps the total heat of powered buildings at their power draw, keeping each building's own self and exhaust split. Buildings without a power draw, heaters, coolers, refrigerators, steam turbines and heavy industry such as refineries, forges and kilns are not changed. Also removes the minimum temperature of building outputs, such as the Electrolyzer's 70 C oxygen, so outputs come out at the temperature of their inputs or of the building (can be turned off in the options)." />
    <Mod Include="CrushingIce" Folder="CrushingIce" Title="Crushing Ice" StaticId="CrushingIce"
         Description="The Rock Crusher can crush ice into Snow. Each recipe takes 100 kg of ice and 40 s: Ice makes 100 kg of Snow, Polluted Ice makes 99 kg of Snow and 1 kg of Dirt, and Brine Ice makes 70 kg of Snow and 30 kg of Salt. The outputs keep the temperature of the ice." />
    <Mod Include="DTUNotIncluded" Folder="DTUNotIncluded" Title="DTU Not Included" StaticId="DTUNotIncluded" MinimumSupportedBuild="744825"
         Description="Shows heat in joules and watts instead of DTU and DTU/s, the units the simulation already uses, so no values change. Heat rates read like power (Heat: +20 kW), specific heat capacity reads J/(g*C) and thermal conductivity reads W/(m*C)." />
    <Mod Include="IrradiationSterilization" Folder="IrradiationSterilization" Title="Irradiation Sterilization" StaticId="IrradiationSterilization"
         Description="Radiation kills a share of the germs every cycle instead of a fixed number, in tiles, pipes, items and buildings. Each germ has a configurable D50, the radiation that kills half of it per cycle: 100 rads for Food Poisoning and Slimelung and 250 for Zombie Spores, while Floral Scent stays immune. The vanilla kill rate stays as a minimum, so small clusters still die quickly. An optional instant-kill radiation level is off by default. Needs Spaced Out, the only mode with radiation." />
    <Mod Include="Laser" Folder="Laser" Title="LASER" StaticId="Laser"
         Description="Adds the LASER, a light with the Ceiling Light art that can be built anywhere, facing up, down, left or right. It lights a straight line of cells, starting at its own, at full brightness with no falloff and no length limit: the beam runs to the first solid tile or the edge of the world, and windows don't stop it. Each LASER has a brightness slider in klux, from 1 klux (1,000 lux) up to the maximum, and draws power in proportion to it, all of it turned into heat. The default brightness (100,000 lux), maximum brightness (1,000,000 lux) and power per 100,000 lux (5 W) are configurable. It sits next to the Ceiling Light in the Furniture menu and is unlocked by the same research, Interior Decor." />
    <Mod Include="LinkedStorage" Folder="LinkedStorage" Title="Linked Storage" StaticId="LinkedStorage"
         Description="Adds four linked buildings that share their contents with every other linked building of the same kind, with no limit on how much they hold: the Linked Storage Bin for solid materials, the Linked Refrigerator for food, and the Linked Liquid and Gas Reservoirs for pipes. Each building is its own interface to the shared contents, with its own filter and its own switches for Duplicants storing and taking. Reservoirs pick the one element their output pipe sends out. Contents are insulated and keep their temperature and germs, and food is kept deep frozen and sterile, so it never spoils. Contents are shared per planetoid by default. Each building uses the art of its vanilla counterpart and needs no power. They can be built anywhere, with no floor needed." />
    <Mod Include="LowPowerFilters" Folder="LowPowerFilters" Title="Low Power Filters" StaticId="LowPowerFilters"
         Description="Gas, liquid and solid filters use a configurable power draw (default 10 W each)." />
    <Mod Include="NoPhaseTransitionDamage" Folder="NoPhaseTransitionDamage" Title="No Phase Transition Damage" StaticId="NoPhaseTransitionDamage" Version="1.0.1"
         Description="Pipes no longer take damage when their contents freeze or boil." />
    <Mod Include="RoboMinerNoFoundation" Folder="RoboMinerNoFoundation" Title="Robo-Miner No Foundation" StaticId="RoboMinerNoFoundation"
         Description="The Robo-Miner can be built anywhere, with no floor, wall or ceiling under it, in any rotation. It keeps running after the tiles around it are dug out." />
    <Mod Include="SolarLuxScaling" Folder="SolarLuxScaling" Title="Solar Lux Scaling" StaticId="SolarLuxScaling"
         Description="When another mod raises the Solar Panel power cap above 380 W, Solar Panel output scales up with it, so the panel reaches its new cap with the same light that gave 380 W in vanilla (717,000 lux summed over its 14 light cells). Works with any mod that changes the cap. Without one, nothing changes." />
    <Mod Include="SublimationSconce" Folder="SublimationSconce" Title="Sublimation Sconce" StaticId="SublimationSconce"
         Description="Adds the Sublimation Sconce, a sconce like the Oxylite Sconce that holds any solid that sublimates, such as Slime, Bleach Stone, Polluted Dirt or Oxylite. Each sconce picks its materials from a list and has a capacity slider. Materials in it sublimate as fast as Oxylite would, unless their own rate is faster, and stop while the gas around the sconce is too dense, like vanilla. The storage capacity (default 240 kg) and the Oxylite rate are configurable. Needs The Frosty Planet Pack, which has the sconce art." />
    <Mod Include="StorageTileInstantSwitch" Folder="StorageTileInstantSwitch" Title="Storage Tile Instant Switch" StaticId="StorageTileInstantSwitch"
         Description="Changing the item a Storage Tile holds takes effect right away, with no Duplicant errand. Items that no longer match drop in the first open cell next to the tile." />
    <Mod Include="SuperMop" Folder="SuperMop" Title="Super Mop" StaticId="SuperMop"
         Description="Removes the 150 kg liquid limit on the Mop tool, so Duplicants can mop any amount of liquid that sits on a floor. Mopping is also faster and wider, with a configurable speed multiplier (default 10x, 1000 kg/s per cell) and reach (default 3 cells to each side instead of 1). Walls stop the reach." />
    <Mod Include="ThermallyConductive" Folder="ThermallyConductive" Title="Thermally Conductive" StaticId="ThermallyConductive"
         Description="Radiant gas and liquid pipes and Thermal Blocks have 1000 times their normal thermal conductivity." />
    <Mod Include="ThermoHeatProduction" Folder="ThermoHeatProduction" Title="Thermo Heat Production" StaticId="ThermoHeatProduction"
         Description="Thermo Regulators and Thermo Aquatuners show a Heat Production status while running, like the Steam Turbine. It shows the heat they move out of the gas or liquid they cool, which the game already tracks but never displays." />
    <Mod Include="TrueInsulation" Folder="TrueInsulation" Title="True Insulation" StaticId="TrueInsulation"
         Description="Insulated gas and liquid pipes, insulation tiles and pressure doors have zero thermal conductivity, so they fully insulate." />
  </ItemGroup>

  <Target Name="Package">
    <RemoveDir Directories="$(OutDir)" />

    <MSBuild Projects="$(RepoDir)ONI-mods.sln" Targets="Build" Properties="Configuration=Release" />

    <MakeDir Directories="$(OutDir)%(Mod.Folder)" />

    <Copy SourceFiles="$(RepoDir)%(Mod.Identity)/bin/Release/%(Mod.Identity).dll" DestinationFolder="$(OutDir)%(Mod.Folder)" />

    <WriteLinesToFile File="$(OutDir)%(Mod.Folder)/mod.yaml" Overwrite="true"
                      Lines="title: &quot;%(Mod.Title)&quot;;description: &quot;%(Mod.Description)&quot;;staticID: &quot;%(Mod.StaticId)&quot;" />

    <WriteLinesToFile File="$(OutDir)%(Mod.Folder)/mod_info.yaml" Overwrite="true"
                      Lines="minimumSupportedBuild: %(Mod.MinimumSupportedBuild) # the lowest game version that will load the mod;version: %(Mod.Version) # version of your mod, displayed on the mod list. for your and users' info;APIVersion: 2 # required to specify that the mod is using Harmony 2 and has been upgraded for the mergedown changes" />
  </Target>
</Project>
